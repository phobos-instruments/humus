msgctxt "category.Buses"
msgid "Buses"
msgstr "Busse"

msgctxt "category.Input/Output"
msgid "Input/Output"
msgstr "Ein-/Ausgang"

msgctxt "category.MIDI Inputs"
msgid "MIDI Inputs"
msgstr "MIDI-Eingänge"

msgctxt "category.MIDI Outputs"
msgid "MIDI Outputs"
msgstr "MIDI-Ausgänge"

msgctxt "category.Mixers"
msgid "Mixers"
msgstr "Mixer"

#: packs/core/organisms/Bus/organism.json
msgctxt "organism.Bus.blurb"
msgid "A named point many cords can meet at, to fan sound in or out."
msgstr ""
"Ein benannter Punkt, an dem sich viele Kabel treffen, um Klang zu bündeln "
"oder zu verteilen."

#: packs/core/organisms/Crossfader/organism.json
msgctxt "organism.Crossfader.blurb"
msgid "Slides between two sounds, one hand on the fade."
msgstr "Gleitet zwischen zwei Klängen hin und her, eine Hand am Fader."

#: packs/core/organisms/FileRecorder/organism.json
msgctxt "organism.FileRecorder.blurb"
msgid "Writes what reaches it to a sound file while the patch plays."
msgstr ""
"Schreibt, was bei ihm ankommt, in eine Audiodatei, während das Patch läuft."

#: packs/core/organisms/Gain/organism.json
msgctxt "organism.Gain.blurb"
msgid "A volume knob with a mute, the plainest box on the canvas."
msgstr ""
"Ein Lautstärkeregler mit Stummschaltung, die schlichteste Box auf der "
"Arbeitsfläche."

#: packs/core/organisms/Invert/organism.json
msgctxt "organism.Invert.blurb"
msgid "Flips a signal upside down, for phase tricks and subtraction."
msgstr "Stellt ein Signal auf den Kopf, für Phasentricks und Subtraktion."

#: packs/core/organisms/MidiBus/organism.json
msgctxt "organism.MidiBus.blurb"
msgid "A named meeting point for MIDI cords."
msgstr "Ein benannter Treffpunkt für MIDI-Kabel."

#: packs/core/organisms/MidiIO/organism.json
msgctxt "organism.MidiIn.blurb"
msgid "Notes and controllers arriving from a MIDI port, or from every port at once."
msgstr ""
"Noten und Controller, die von einem MIDI-Port ankommen, oder von allen Ports "
"zugleich."

#: packs/core/organisms/MidiIO/organism.json
msgctxt "organism.MidiOut.blurb"
msgid "Sends notes and controllers out to a MIDI port."
msgstr "Schickt Noten und Controller an einen MIDI-Port."

#: packs/core/organisms/Mixer/organism.json
msgctxt "organism.Mixer.blurb"
msgid "Several sounds into one, each with its own level and pan."
msgstr "Mehrere Klänge zu einem, jeder mit eigenem Pegel und Panorama."

#: packs/core/organisms/Send/organism.json
msgctxt "organism.Send.blurb"
msgid "A tap that mails a copy of a sound to a bus, wet next to dry."
msgstr ""
"Ein Abgriff, der eine Kopie eines Klangs an einen Bus schickt, Effektsignal "
"neben Direktsignal."

#: packs/core/organisms/SoundIn/organism.json
msgctxt "organism.SoundIn.blurb"
msgid "The sound coming into the interface, one channel per box."
msgstr "Der Klang, der ins Interface hineinkommt, ein Kanal pro Box."

#: packs/core/organisms/SoundOut/organism.json
msgctxt "organism.SoundOut.blurb"
msgid "The interface output, where the patch is finally heard."
msgstr "Der Ausgang des Interfaces, wo das Patch am Ende zu hören ist."
