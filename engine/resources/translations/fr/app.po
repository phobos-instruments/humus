msgid "An endless knob. Each detent nudges the parameter by Step. Pick the format your controller sends; Learn guesses it for you."
msgstr ""
"Un bouton rotatif sans butée. Chaque cran décale le paramètre d'un Pas. "
"Choisis le format qu'envoie ton contrôleur ; Learn le devine pour toi."

#: engine/src/gui/properties/ControlModeText.h
msgctxt "control-mode.hint-hold"
msgid "On while held, off when released."
msgstr "Activé tant que tu appuies, désactivé au relâchement."

#: engine/src/gui/properties/ControlModeText.h
msgctxt "control-mode.hint-pick-up"
msgid "Nothing moves until the knob passes where the parameter already is, so a preset or an on-screen change never jumps. Right-click a point to remove it."
msgstr ""
"Rien ne bouge tant que le bouton n'a pas rejoint la position actuelle du "
"paramètre : un preset ou un réglage à l'écran ne fait donc jamais de saut. "
"Clic droit sur un point pour le retirer."

#: engine/src/gui/properties/ControlModeText.h
msgctxt "control-mode.hint-reset"
msgid "Each press returns the parameter to its default."
msgstr "Chaque appui ramène le paramètre à sa valeur par défaut."

#: engine/src/gui/properties/ControlModeText.h
msgctxt "control-mode.hint-set"
msgid "Each press sets the parameter to the To value."
msgstr "Chaque appui règle le paramètre sur la valeur « à »."

#: engine/src/gui/properties/ControlModeText.h
msgctxt "control-mode.hint-step-down"
msgid "Each press moves the parameter down by Step. Lists and whole numbers move one item."
msgstr ""
"Chaque appui fait descendre le paramètre d'un Pas. Les listes et les nombres "
"entiers reculent d'un élément."

#: engine/src/gui/properties/ControlModeText.h
msgctxt "control-mode.hint-step-up"
msgid "Each press moves the parameter up by Step. Lists and whole numbers move one item."
msgstr ""
"Chaque appui fait monter le paramètre d'un Pas. Les listes et les nombres "
"entiers avancent d'un élément."

#: engine/src/gui/properties/ControlModeText.h
