#pragma once
// GENERATED by engine/CMakeLists.txt from the packs that declared themselves
// add-ons. The CLI links them statically so repo patches render without an
// install; the app meets them only as installed .humpacks.
#include <initializer_list>
#include <string>

#include "core/packs/PackRegistry.h"
#include "hum/Registry.h"

namespace hum {
@HUM_ADDON_DECLS@
inline void registerStaticAddonPacks() {
@HUM_ADDON_CALLS@
    const auto root = PackRegistry::packsRootDir();
    if (root.empty()) return;
    for (const char* id : std::initializer_list<const char*>{@HUM_ADDON_IDS@})
        PackRegistry::instance().loadPackDir(root + "/" + id, /*builtin*/ true);
}
}  // namespace hum
