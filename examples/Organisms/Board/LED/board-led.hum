<?xml version="1.0" encoding="UTF-8"?>

<humus-document version="1">
  <patch>
    <clock tempo="120.0" loop-start="0.0" loop-end="0.0" loop-enabled="0"/>
    <contraption class="SoundIn" name="SoundIn">
      <properties>
        <property index="0" name="Channel">
          <int>1</int>
        </property>
      </properties>
      <presets current-preset-dirty="1"/>
      <modulation-sources/>
    </contraption>
    <contraption class="Follower" name="Follower">
      <properties>
        <property index="0" name="Attack">
          <double>5</double>
        </property>
        <property index="1" name="Release">
          <double>150</double>
        </property>
        <property index="3" name="Threshold">
          <double>0.1</double>
        </property>
      </properties>
      <presets current-preset-dirty="1"/>
      <modulation-sources/>
    </contraption>
    <contraption class="Board" name="Board">
      <properties>
        <property index="0" name="Device">
          <int>1</int>
        </property>
        <property index="1" name="BaudRate">
          <enum>7</enum>
        </property>
        <property index="7" name="Inlets">
          <int>2</int>
        </property>
        <property index="20" name="Pin1">
          <int>13</int>
        </property>
        <property index="21" name="Mode1">
          <enum>0</enum>
        </property>
        <property index="22" name="Pin2">
          <int>11</int>
        </property>
        <property index="23" name="Mode2">
          <enum>1</enum>
        </property>
      </properties>
      <presets current-preset-dirty="1"/>
      <modulation-sources>
        <property-sources property-name="In1" property-index="-1">
          <mod-controller source-organism="Follower" source-value="gate" map-minimum="0.0"
                          map-maximum="1.0"/>
        </property-sources>
        <property-sources property-name="In2" property-index="-1">
          <mod-controller source-organism="Follower" source-value="env" map-minimum="0.0"
                          map-maximum="1.0"/>
        </property-sources>
      </modulation-sources>
    </contraption>
    <audio-connection from="SoundIn" from-outlet="0" to="Follower" to-inlet="0"/>
  </patch>
  <contraption-views>
    <contraption-view contraption-name="SoundIn" patcher-x="492" patcher-y="40" editor-visible="0"
                      editor-x="40" editor-y="40"/>
    <contraption-view contraption-name="Follower" patcher-x="492" patcher-y="126" editor-visible="1"
                      editor-x="40" editor-y="200"/>
    <contraption-view contraption-name="Board" patcher-x="492" patcher-y="212" editor-visible="1"
                      editor-x="40" editor-y="360"/>
  </contraption-views>
  <automation-views/>
  <performance-boxes/>
  <notes>The microphone lights an LED on a board running the standard Firmata sketch: the Follower's gate switches pin 13 through Board's first socket, its envelope dims pin 11 through the second. Flash StandardFirmata, plug the board in, play into the microphone.</notes>
</humus-document>
